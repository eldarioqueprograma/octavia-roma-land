# EmailJS Configuration
# Sign up at https://www.emailjs.com/ (free tier available)
# Then:
# 1. Create an Email Service (e.g., Gmail, Outlook, custom SMTP)
# 2. Create an Email Template with variables: to_email, type, quantity, total, message
# 3. Copy the IDs below

PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here
PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
