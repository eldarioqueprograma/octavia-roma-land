---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="mx-auto max-w-4xl px-6 py-16">
    <div class="flex flex-wrap items-center gap-4 mb-6">
      <img src="/Gemini_Generated_Image_2a7lp72a7lp72a7l-removebg-preview.png" alt="Octavia Roma Land logo" class="h-14 w-auto" />
      <div>
        <h1 class="text-4xl font-semibold text-white">Comprar entradas — Octavia Roma Land</h1>
        <p class="text-slate-300">Selecciona tu entrada y deja tu correo para reservar. Esta página no procesa pagos — solo reserva.</p>
      </div>
    </div>

    <div class="mb-8">
      <p class="text-sm uppercase tracking-[0.24em] text-slate-400">Packs disponibles</p>
      <h2 class="mt-2 text-3xl font-semibold text-white">Elige tu entrada</h2>
      <p class="mt-3 text-slate-400">Selecciona entre los packs oficiales para vivir Octavia Roma Land con la experiencia que más te guste.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-3 mb-8">
      <div class="roman-card p-6 rounded-2xl text-center">
        <p class="text-sm uppercase tracking-[0.24em] text-amber-300">Familia</p>
        <p class="mt-4 text-3xl font-bold text-white">€35</p>
        <p class="mt-2 text-sm text-slate-400">2 adultos + 2 niños — acceso a atracciones</p>
      </div>
      <div class="roman-card p-6 rounded-2xl text-center">
        <p class="text-sm uppercase tracking-[0.24em] text-emerald-300">Gladiador</p>
        <p class="mt-4 text-3xl font-bold text-white">€25</p>
        <p class="mt-2 text-sm text-slate-400">Entrada general + reserva rápida para espectáculos</p>
      </div>
      <div class="roman-card p-6 rounded-2xl text-center">
        <p class="text-sm uppercase tracking-[0.24em] text-cyan-300">Imperial</p>
        <p class="mt-4 text-3xl font-bold text-white">€48</p>
        <p class="mt-2 text-sm text-slate-400">Paquete premium: guía, acceso nocturno y cena</p>
      </div>
    </div>

    <form id="reserve-form" class="space-y-4 bg-slate-900/80 p-6 rounded-2xl">
      <div>
        <label class="block text-sm text-slate-300 mb-2">Tipo de entrada</label>
        <select id="ticketType" class="w-full rounded-md bg-slate-800 text-white p-3">
          <option value="Familia">Familia — €35</option>
          <option value="Gladiador">Gladiador — €25</option>
          <option value="Imperial">Imperial — €48</option>
        </select>
      </div>

      <div>
        <label class="block text-sm text-slate-300 mb-2">Cantidad</label>
        <input id="quantity" type="number" min="1" value="1" class="w-full rounded-md bg-slate-800 text-white p-3" />
      </div>

      <div>
        <label class="block text-sm text-slate-300 mb-2">Correo electrónico</label>
        <input id="email" type="email" required class="w-full rounded-md bg-slate-800 text-white p-3" />
      </div>

      <div class="flex items-center gap-3">
        <button type="button" id="reserveBtn" class="rounded-full bg-amber-400 px-6 py-3 text-sm font-semibold text-slate-950">Reservar (sin pago)</button>
        <button id="clearBtn" type="button" class="rounded-full bg-slate-700 px-4 py-2 text-sm text-white">Limpiar</button>
      </div>

      <div id="reserveResult" class="mt-4 text-sm text-emerald-300" aria-live="polite"></div>
    </form>

    <div id="priceTotal" class="mt-8 text-center">
      <p class="text-sm text-slate-400">Total a pagar</p>
      <p id="totalAmount" class="mt-2 text-5xl font-bold text-amber-300">€35</p>
    </div>

  </main>

  <script type="module">
    import emailjs from '@emailjs/browser';
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('reserve-form');
      if (!form) return;

      const result = document.getElementById('reserveResult');
      const reserveBtn = document.getElementById('reserveBtn');
      const clearBtn = document.getElementById('clearBtn');

      /** @type {{Familia:number,Gladiador:number,Imperial:number}} */
      const prices = { Familia: 35, Gladiador: 25, Imperial: 48 };

      const ticketType = /** @type {HTMLSelectElement} */ (document.getElementById('ticketType'));
      const quantity = /** @type {HTMLInputElement} */ (document.getElementById('quantity'));
      const totalAmount = /** @type {HTMLElement} */ (document.getElementById('totalAmount'));

      if (!ticketType || !quantity || !totalAmount) return;

      const PUBLIC_EMAILJS_PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY || '';
      const PUBLIC_EMAILJS_SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID || '';
      const PUBLIC_EMAILJS_TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID || '';

      if (!PUBLIC_EMAILJS_PUBLIC_KEY || !PUBLIC_EMAILJS_SERVICE_ID || !PUBLIC_EMAILJS_TEMPLATE_ID) {
        if (result) result.textContent = 'Error de configuración: falta EmailJS PUBLIC_KEY o SERVICE_ID o TEMPLATE_ID en producción.';
        return;
      }

      emailjs.init(PUBLIC_EMAILJS_PUBLIC_KEY);

      const MAX_TOTAL = 800;

      function computeTotal() {
        const type = ticketType.value;
        const qty = Math.max(1, parseInt(quantity.value || '1', 10));
        const price = prices[type] || 0;
        return price * qty;
      }

      function updateTotal() {
        const total = computeTotal();
        totalAmount.textContent = `€${total.toFixed(2)}`;
      }

      ticketType.addEventListener('change', updateTotal);
      quantity.addEventListener('input', updateTotal);
      updateTotal();

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailEl = /** @type {HTMLInputElement} */ (document.getElementById('email'));
        const email = emailEl ? emailEl.value.trim() : '';
        if (!email) {
          if (result) result.textContent = 'Introduce un correo válido.';
          return;
        }

        const type = ticketType.value;
        const qty = Math.max(1, parseInt(quantity.value || '1', 10));
        const total = computeTotal();

        if (total > MAX_TOTAL) {
          if (result) result.textContent = `El total (€${total.toFixed(2)}) supera el máximo permitido de €${MAX_TOTAL}. Reduce la cantidad o elige otra entrada.`;
          return;
        }

        if (reserveBtn) reserveBtn.disabled = true;
        try {
          await emailjs.send(
            PUBLIC_EMAILJS_SERVICE_ID,
            PUBLIC_EMAILJS_TEMPLATE_ID,
            {
              to_email: email,
              type: type,
              quantity: qty,
              total: total.toFixed(2),
              message: `Gracias por tu reserva de ${qty}x ${type} por €${total.toFixed(2)}. Esperamos verte en Octavia Roma Land.`
            }
          );
          if (result) result.textContent = 'Reserva enviada. Revisa tu correo para la confirmación.';
        } catch (err) {
          if (result) result.textContent = `Error enviando reserva: ${err.message}`;
        } finally {
          if (reserveBtn) reserveBtn.disabled = false;
        }
      });

      if (reserveBtn) {
        reserveBtn.addEventListener('click', (e) => {
          e.preventDefault();
          form.requestSubmit();
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          quantity.value = '1';
          const emailEl = /** @type {HTMLInputElement} */ (document.getElementById('email'));
          if (emailEl) emailEl.value = '';
          if (result) result.textContent = '';
          updateTotal();
        });
      }
    });
  </script>
</Layout>
