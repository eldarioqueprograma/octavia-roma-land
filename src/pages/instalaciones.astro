---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="max-w-6xl px-6 py-16">
    <div class="space-y-6">
      <p class="text-sm uppercase tracking-[0.32em] text-emerald-300">Instalaciones</p>
      <h1 class="text-5xl font-semibold text-white sm:text-6xl">Cosas mejores que simples atracciones y espectaculos</h1>
      
    </div>

    
    <div class="mt-12 grid gap-6 lg:grid-cols-2">

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
          
          <h3 class="mt-4 text-2xl font-semibold text-white">Asador Las Tabernae</h3>
          <p class="mt-4 text-slate-400">Restaurante temático que ofrece comida tradicional romana en un entorno histórico.</p>
        </div>
        <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
          
          <h3 class="mt-4 text-2xl font-semibold text-white">Las Termas de Caracalla</h3>
          <p class="mt-4 text-slate-400">Spa romano con baños y servicios de cuidado personal en un entorno histórico.</p>
        </div>
        <h3 class="mt-4 text-2xl font-semibold text-white">Todas estas atracciones estan en la area 2</h3>
        
    
  </main>
</Layout>
