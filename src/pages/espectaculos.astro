---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="mx-auto max-w-6xl px-6 py-16">
    <div class="space-y-6">
      <p class="text-sm uppercase tracking-[0.32em] text-emerald-300">Espectáculos</p>
      <h1 class="text-5xl font-semibold text-white sm:text-6xl">Espectáculos sin páginas individuales</h1>
      
    </div>

    <section class="mt-12">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm uppercase tracking-[0.24em] text-slate-400">Acción en vivo</p>
          <h2 class="mt-2 text-3xl font-semibold text-white">Show y aventuras dinámicas</h2>
        </div>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
          <p class="text-sm uppercase tracking-[0.28em] text-amber-300">Área 3</p>
          <h3 class="mt-4 text-2xl font-semibold text-white">Circus Maximus</h3>
          <p class="mt-4 text-slate-400">Carreras de cuádrigas inspiradas en el Circo Máximo, con velocidad y emoción para toda la familia.</p>
        </div>
        <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
          <p class="text-sm uppercase tracking-[0.28em] text-cyan-300">Área 3</p>
          <h3 class="mt-4 text-2xl font-semibold text-white">Coliseo VR: Naumaquias y Gladiadores</h3>
          <p class="mt-4 text-slate-400">Experiencia de realidad virtual que mezcla combates de gladiadores con batallas navales en el Coliseo.</p>
        </div>
        <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
          <p class="text-sm uppercase tracking-[0.28em] text-cyan-300">Área 3</p>
          <h3 class="mt-4 text-2xl font-semibold text-white">Escape de Pompeya</h3>
          <p class="mt-4 text-slate-400">Aventura inmersiva en la ciudad de Pompeya, con efectos especiales para escapar antes de la erupción.</p>
        </div>
      </div>
    </section>

    <section class="mt-12">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm uppercase tracking-[0.24em] text-slate-400">Eventos épicos</p>
          <h2 class="mt-2 text-3xl font-semibold text-white">Drama histórico y acción final</h2>
        </div>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
          <p class="text-sm uppercase tracking-[0.28em] text-emerald-300">Área 4</p>
          <h3 class="mt-4 text-2xl font-semibold text-white">Invasión Bárbara 476</h3>
          <p class="mt-4 text-slate-400">Montaña rusa intensa que recrea la caída de Roma con un final épico y adrenalínico.</p>
        </div>
        <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
          <p class="text-sm uppercase tracking-[0.28em] text-cyan-300">Área 1</p>
          <h3 class="mt-4 text-2xl font-semibold text-white">El Consejo del Senado</h3>
          <p class="mt-4 text-slate-400">Teatro interactivo donde el público presencia las decisiones y conspiraciones del Senado romano.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
