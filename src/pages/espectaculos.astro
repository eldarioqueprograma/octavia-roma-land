---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="mx-auto max-w-6xl px-6 py-16">
    <div class="space-y-6">
      <p class="text-sm uppercase tracking-[0.32em] text-emerald-300">Espectáculos</p>
      <h1 class="text-5xl font-semibold text-white sm:text-6xl">Los mejores espectáculos de Roma</h1>
      
    </div>

    <section class="mt-12">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm uppercase tracking-[0.24em] text-slate-400">Acción en vivo</p>
          <h2 class="mt-2 text-3xl font-semibold text-white">Show y aventuras dinámicas</h2>
        </div>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="group relative overflow-hidden rounded-[2rem] border border-slate-700">
          <img src="https://images.pexels.com/photos/35109338/pexels-photo-35109338.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Coliseo VR" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-slate-900/20"></div>
          <div class="relative z-10 p-8">
            <p class="text-sm uppercase tracking-[0.28em] text-violet-300">Área 3 — El Gran Imperio y la Vida Urbana</p>
            <h3 class="mt-4 text-2xl font-semibold text-white">Coliseo VR: Naumaquias y Gladiadores</h3>
            <p class="mt-4 text-slate-300">Simulador inmersivo en 3D dentro de un anfiteatro: combates de gladiadores, ataques de fieras e inundación total para una batalla naval.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm uppercase tracking-[0.24em] text-slate-400">Eventos épicos</p>
          <h2 class="mt-2 text-3xl font-semibold text-white">Drama histórico y acción final</h2>
        </div>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="group relative overflow-hidden rounded-[2rem] border border-slate-700">
          <img src="https://loremflickr.com/800/600/wolf,statue,rome?lock=10" alt="La Gran Historia de Rómulo y Remo" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-slate-900/20"></div>
          <div class="relative z-10 p-8">
            <p class="text-sm uppercase tracking-[0.28em] text-amber-300">Área 1 — Los Orígenes y la Monarquía</p>
            <h3 class="mt-4 text-2xl font-semibold text-white">La Gran Historia de Rómulo y Remo</h3>
            <p class="mt-4 text-slate-300">Mostramos con esculturas diferentes escenas del mito de Rómulo y Remo, como vivían con una loba, cómo escuchaban a los dioses, y cómo Rómulo mató a su hermano Remo.</p>
          </div>
        </div>
        <div class="group relative overflow-hidden rounded-[2rem] border border-slate-700">
          <img src="https://images.pexels.com/photos/20184618/pexels-photo-20184618.jpeg?auto=compress&cs=tinysrgb&w=800" alt="El Gran Panteón" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-slate-900/20"></div>
          <div class="relative z-10 p-8">
            <p class="text-sm uppercase tracking-[0.28em] text-emerald-300">Área 4 — Religión, Cultura y la Caída del Imperio</p>
            <h3 class="mt-4 text-2xl font-semibold text-white">El Gran Panteón</h3>
            <p class="mt-4 text-slate-300">Museo monumental con cúpula de caementum que alberga esculturas como el Augusto de Prima Porta, mosaicos y pinturas pompeyanas.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
