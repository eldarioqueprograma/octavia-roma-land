---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="mx-auto max-w-6xl px-6 py-16">
    <div class="space-y-6">
      <p class="text-sm uppercase tracking-[0.32em] text-amber-300">Atracciones</p>
      <h1 class="text-5xl font-semibold text-white sm:text-6xl">Atracciones oficiales del texto</h1>
      
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
        <p class="text-sm uppercase tracking-[0.28em] text-amber-300">Área 1</p>
        <h2 class="mt-4 text-3xl font-semibold text-white">El Odiseo de los Dioses</h2>
        <p class="mt-4 text-slate-400">Montaña rusa familiar donde los visitantes sienten la aventura de la mitología romana en primera persona.</p>
      </div>
      <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
        <p class="text-sm uppercase tracking-[0.28em] text-amber-300">Área 2</p>
        <h2 class="mt-4 text-3xl font-semibold text-white">Mare Nostrum</h2>
        <p class="mt-4 text-slate-400">Espectáculo acuático y paseo en barca donde los usuarios viven las batallas del Mediterráneo.</p>
      </div>
      <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
        <p class="text-sm uppercase tracking-[0.28em] text-cyan-300">Área 2</p>
        <h2 class="mt-4 text-3xl font-semibold text-white">La Revuelta de Espartaco</h2>
        <p class="mt-4 text-slate-400">Torre de caída libre que pone a los visitantes en el centro de la rebelión contra Roma.</p>
      </div>
      <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
        <p class="text-sm uppercase tracking-[0.28em] text-violet-300">Área 2</p>
        <h2 class="mt-4 text-3xl font-semibold text-white">Comienza la Expansión</h2>
        <p class="mt-4 text-slate-400">Paseo inmersivo donde los usuarios recorren las conquistas y siente el crecimiento de Roma.</p>
      </div>
      <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
        <p class="text-sm uppercase tracking-[0.28em] text-cyan-300">Área 3</p>
        <h2 class="mt-4 text-3xl font-semibold text-white">Escape de Pompeya</h2>
        <p class="mt-4 text-slate-400">Recorrido interactivo para escapar de la erupción del Vesubio con efectos especiales.</p>
      </div>
      <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
        <p class="text-sm uppercase tracking-[0.28em] text-cyan-300">Área 4</p>
        <h2 class="mt-4 text-3xl font-semibold text-white">Laberinto de las Catacumbas</h2>
        <p class="mt-4 text-slate-400">Pasaje subterráneo inmersivo donde los visitantes viven el misterio y la atmósfera de las catacumbas.</p>
      </div>
      <div class="rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8">
        <p class="text-sm uppercase tracking-[0.28em] text-emerald-300">Área 4</p>
        <h2 class="mt-4 text-3xl font-semibold text-white">Invasión Bárbara 476</h2>
        <p class="mt-4 text-slate-400">Montaña rusa intensa que sumerge a los visitantes en la caída del Imperio.</p>
      </div>
    </div>
  </main>
</Layout>
